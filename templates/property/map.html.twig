{% extends 'layout/base.html.twig' %}

{% block title %}{{ "title.properties_on_map"|trans }}{% endblock %}

{% block description %}{{ site.meta_description }}{% endblock %}

{% block body %}

    {% if is_granted('ROLE_ADMIN') %}

        <a href="{{ url('admin_map_settings') }}" class="btn btn-primary float">
            <i class="fas fa-cog float-icon"></i>
        </a>

    {% endif %}

    <div id="map"
         class="mb-3 mt-3"
         data-markers="{{ markers|json_encode|e('html_attr') }}"
         data-center="{{ map_center|json_encode|e('html_attr') }}"
         data-zoom="{{ map_zoom }}"
         data-view-details="{{ 'view_details'|trans|e('html_attr') }}"
    ></div>

{% endblock %}

{% block javascripts %}

    {% if site.ymaps_key != '' %}

        <script src="https://api-maps.yandex.ru/2.1/?apikey={{ site.ymaps_key }}&lang={{ app.request.locale }}"></script>

    {% else %}

        <script src="https://api-maps.yandex.ru/2.1/?lang={{ app.request.locale }}"></script>

    {% endif %}

    {{ encore_entry_script_tags('js/properties-map') }}

{% endblock %}
